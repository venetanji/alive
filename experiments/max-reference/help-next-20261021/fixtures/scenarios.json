      "name": "scalar-cold-trigger",
      "objects": [
        "trigger",
        "float",
        "int"
      ],
      "purpose": "The right trigger outlet stores a float before the left bang recalls it; the next integer stage truncates toward zero.",
      "patch_file": "fixtures/scalar-cold-trigger.ultra",
      "operations": [
        {
          "event": {
            "node": 1,
            "inlet": 0,
            "text": "-7.75"
          },
          "expected": [
            {
              "id": 2,
              "value": -7.75
            },
            {
              "id": 4,
              "value": -7,
              "pulses": 1
            }
          ]
        },
        {
          "event": {
            "node": 1,
            "inlet": 0,
            "text": "6.25"
          },
          "expected": [
            {
              "id": 4,
              "value": 6,
              "pulses": 2
            }
          ]
        }
      ]
    },
