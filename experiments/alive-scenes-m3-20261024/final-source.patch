+  if (status == ALIVE_SESSION_V3_CANCELED) r.canceled_mask |= mask;
+  if (status == ALIVE_SESSION_V3_REJECTED) r.rejected_mask |= mask;
+  if (reason_priority(error) > reason_priority(r.error)) r.error = error;
