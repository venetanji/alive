+// Real controller JSON transport against a synthetic File boundary; no target launch.
+const fs=require('fs'),vm=require('vm'),assert=require('assert'),path=require('path');
+const source=fs.readFileSync(path.join(__dirname,'controller.js'),'utf8');
+function fixture(initial={},fault=null) {
+ const disk=new Map(Object.entries(initial).map(([name,text])=>[name,Buffer.from(text,'utf8')]));
+ const handles=[],writes=[],reads=[];let writeCalls=0,readCalls=0;
+ const ctx=vm.createContext({jsarguments:['js','synthetic-config']});vm.runInContext(source,ctx);
+ ctx.File=function(name,mode) {
+  const file=this;let position=fault==='read-start'?1:0;
+  this.isopen=fault!=='unavailable'&&(mode!=='read'||disk.has(name));this.closed=false;handles.push(this);
+  if(mode!=='read'&&!disk.has(name))disk.set(name,Buffer.alloc(0));
+  Object.defineProperty(this,'position',{get:()=>position,set:v=>{position=fault==='bad-reset'?1:v;}});
+  Object.defineProperty(this,'eof',{get:()=>disk.get(name).length+(fault==='bad-eof'&&writeCalls?1:0),set:v=>{
+   if(fault==='truncate-throw')throw Error('synthetic truncate failure');
+   const old=disk.get(name),next=Buffer.alloc(v);old.copy(next,0,0,Math.min(old.length,v));disk.set(name,next);
+  }});
+  function append(text) {
+   const bytes=Buffer.from(text,'utf8'),old=disk.get(name),next=Buffer.alloc(Math.max(old.length,position+bytes.length));
+   old.copy(next);bytes.copy(next,position);disk.set(name,next);position+=bytes.length;
+  }
+  this.writeline=text=>{append(text.slice(0,32768)+'\n');};
+  this.writestring=text=>{
+   assert.equal(file.closed,false);assert.ok(text.length<=4096,'every write must stay below the observed boundary');
+   assert.ok(/^[\x00-\x7f]*$/.test(text),'chunks must contain only ASCII bytes');writes.push(text.length);++writeCalls;
+   if(fault==='write-throw'&&writeCalls===2)throw Error('synthetic write failure');
+   if(fault==='write-stall'&&writeCalls===2)return;
+   append(fault==='write-short'&&writeCalls===2?text.slice(0,-1):text);
+  };
+  this.readline=(count=512)=>{
+   const bytes=disk.get(name),end=bytes.indexOf(10,position),stop=Math.min(position+count,end<0?bytes.length:end);
+   const text=bytes.subarray(position,stop).toString('utf8');position=stop;
+   if(position<bytes.length&&bytes[position]===10)++position;return text;
+  };
+  this.readstring=count=>{
+   assert.equal(file.closed,false);assert.ok(count>0&&count<=4096,'reads must be bounded');reads.push(count);++readCalls;
+   if(fault==='read-throw'&&readCalls===2)throw Error('synthetic read failure');
+   if(fault==='read-stall'&&readCalls===2)return '';
+   if(fault==='read-eof'&&readCalls===2)disk.set(name,disk.get(name).subarray(0,position));
+   const bytes=disk.get(name),length=Math.min(count,bytes.length-position)-(fault==='read-short'&&readCalls===2?1:0);
+   const text=bytes.subarray(position,position+length).toString('utf8');position+=length;
+   if(fault==='read-grow'&&readCalls===1)disk.set(name,Buffer.concat([bytes,Buffer.from('extra')]));
+   return fault==='read-loss'&&readCalls===2?text.slice(0,-1):text;
+  };
+  this.close=()=>{this.closed=true;};
+ };
+ return {ctx,disk,writes,reads,handles,closed(){
+  for(const h of handles)if(h.isopen)assert.equal(h.closed,true,'every opened handle must close, including failures');
+ }};
