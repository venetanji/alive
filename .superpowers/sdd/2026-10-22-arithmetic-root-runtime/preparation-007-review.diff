+    take('command-consumed', 0, dict(working_path=definition['working_windows_path']))
+    for phase in ('openfile-enter', 'openfile-return', 'poll-scheduled'): take(phase, 0)
+    geometry_anchors = list(PLUS_GEOMETRY_PINS)
