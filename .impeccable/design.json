  "narrative": {
    "northStar": "The patch is the interface",
    "overview": "The user chose a close Max/MSP match. The workspace follows the installed Max\n9.1.5 reference: charcoal canvas, dark compact objects, amber names, light\narguments and small port rails. This is a working musical editor for sustained\ndesktop use, with enough unused canvas for the patch to grow.\n\nThe authored graph carries the visual hierarchy. Chrome stays compact and\npanels open on demand. Controls respond immediately to editing and performance\nstate; there is no decorative entrance motion. Icons and controls are original\nSVG/CSS, with no Max application assets in the build.\n\nThe default control family for new Ultra device interfaces follows the installed\nLive device language and is shared with Alive through one original API. Open\ndial arcs, restrained value accents, neutral numeric readouts and orange section\nswitches sit on flat charcoal panels. The current integration covers Ultra\nPerform and Alive device parameters; it does not establish a complete Analog\ndevice editor or migrate existing canvas object faces.",
    "keyCharacteristics": [
      "Compact, direct object editing.",
      "Distinct control, mono and stereo connections.",
      "Optional library, inspector and help.",
      "Visible keyboard focus and explicit lock state.",
      "One shared device-control family for Ultra and Alive."
    ],
    "rules": [
      {
        "name": "The Signal Type Rule",
        "body": "Color accompanies cord shape and textual port types; it never supplies the only distinction between control, mono and stereo.",
        "section": "colors"
      },
      {
        "name": "The Value Accent Rule",
        "body": "Cyan belongs to arcs and value accents. Numeric readouts remain neutral, as in the retained Analog device reference.",
        "section": "colors"
      },
      {
        "name": "The Object Text Rule",
        "body": "Names and arguments share one readable baseline. Additional diagnostics belong in the optional inspector, not inside every box.",
        "section": "typography"
      },
      {
        "name": "The Stable Canvas Rule",
        "body": "Objects and cords retain their position while runtime observations update. Editing actions and state changes need no entrance animation or ornamental movement.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve compact Max-inspired object dimensions and direct text editing.",
      "Do place inlet and outlet descriptions beside the interaction they explain.",
      "Do keep authoring state distinct from runtime observations.",
      "Do use shape and text alongside signal colors.",
      "Do use the shared Live-style API for new Ultra and Alive device controls.",
      "Do keep shared numeric readouts neutral and reserve cyan for arcs and accents."
    ],
    "donts": [
      "Don't replace the patch with permanent object cards and debug readouts.",
      "Don't imply that a familiar name guarantees Max semantics.",
      "Don't replace native execution with a simulated browser audio state.",
      "Don't add a second Max-looking default control family or compatibility skin.",
      "Don't treat the shared family as proof that canvas faces or a full Analog device editor have been migrated."
    ]
  }
}
