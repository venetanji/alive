      "css": ".ds-entry{font:12px \"Liberation Sans\", \"Helvetica Neue\", sans-serif;color:var(--object-name);background:var(--object);padding:0 6px;height:24px;width:100px;border:1px solid var(--selection);border-radius:1px;outline:none}.ds-entry:focus-visible{outline:none}"
    },
    {
      "name": "Port Menu",
      "kind": "custom",
      "description": "Directional help for the selected port.",
      "html": "<div class=\"ds-menu\"><strong>metro / inlet 0</strong><p>Accepts 0, 1, bang.</p><button>Help for metro</button></div>",
      "css": ".ds-menu{font:12px \"Liberation Sans\", \"Helvetica Neue\", sans-serif;color:var(--text);width:250px;background:#272727;border:1px solid #737373;border-radius:3px;padding:12px}.ds-menu strong{font-weight:400;color:var(--object-name)}.ds-menu p{color:var(--muted);font-size:11px;line-height:1.6}.ds-menu button{font:12px \"Liberation Sans\", \"Helvetica Neue\", sans-serif;color:var(--text);background:transparent;border:0;border-radius:3px;padding:7px 8px;cursor:pointer}.ds-menu button:hover{background:#414141}.ds-menu button:focus-visible{outline:2px solid var(--selection);outline-offset:2px;}"
    },
    {
      "name": "Bang Button",
      "kind": "button",
      "description": "A compact trigger face, distinct from a text object.",
      "html": "<button class=\"ds-bang\" aria-label=\"Trigger bang\"></button>",
      "css": ".ds-bang{width:24px;height:24px;background:var(--object);border:0;padding:0;cursor:pointer}.ds-bang::before{content:\"\";display:block;width:13px;height:13px;margin:3px auto;border-radius:50%;border:2px solid #a7a7a4;box-sizing:border-box}.ds-bang:hover{background:#414141}.ds-bang:active::before{background:var(--object-name);border-color:var(--object-name)}.ds-bang:focus-visible{outline:2px solid var(--selection);outline-offset:2px;}"
    },
    {
      "name": "Shared Dial and Slider",
      "kind": "custom",
      "refersTo": "live-dial",
      "description": "Original open-arc dial and flat slider with neutral readouts; Ultra and Alive share the same family. This is a visual specimen of the runtime factories.",
      "html": "<div class=\"ds-live-controls\"><label class=\"ds-live-control\"><span>Cutoff</span><span class=\"ds-live-dial\"><svg viewBox=\"0 0 52 52\" aria-hidden=\"true\"><line x1=\"9.737\" y1=\"42.263\" x2=\"8.322\" y2=\"43.678\" stroke=\"var(--live-muted,#b5b5b5)\" stroke-width=\"1\"/><line x1=\"4.126\" y1=\"33.107\" x2=\"2.224\" y2=\"33.725\" stroke=\"var(--live-muted,#b5b5b5)\" stroke-width=\"1\"/><line x1=\"3.283\" y1=\"22.402\" x2=\"1.308\" y2=\"22.089\" stroke=\"var(--live-muted,#b5b5b5)\" stroke-width=\"1\"/><line x1=\"7.393\" y1=\"12.481\" x2=\"5.775\" y2=\"11.305\" stroke=\"var(--live-muted,#b5b5b5)\" stroke-width=\"1\"/><line x1=\"15.558\" y1=\"5.507\" x2=\"14.650\" y2=\"3.725\" stroke=\"var(--live-muted,#b5b5b5)\" stroke-width=\"1\"/><line x1=\"26.000\" y1=\"3.000\" x2=\"26.000\" y2=\"1.000\" stroke=\"var(--live-muted,#b5b5b5)\" stroke-width=\"1\"/><line x1=\"36.442\" y1=\"5.507\" x2=\"37.350\" y2=\"3.725\" stroke=\"var(--live-muted,#b5b5b5)\" stroke-width=\"1\"/><line x1=\"44.607\" y1=\"12.481\" x2=\"46.225\" y2=\"11.305\" stroke=\"var(--live-muted,#b5b5b5)\" stroke-width=\"1\"/><line x1=\"48.717\" y1=\"22.402\" x2=\"50.692\" y2=\"22.089\" stroke=\"var(--live-muted,#b5b5b5)\" stroke-width=\"1\"/><line x1=\"47.874\" y1=\"33.107\" x2=\"49.776\" y2=\"33.725\" stroke=\"var(--live-muted,#b5b5b5)\" stroke-width=\"1\"/><line x1=\"42.263\" y1=\"42.263\" x2=\"43.678\" y2=\"43.678\" stroke=\"var(--live-muted,#b5b5b5)\" stroke-width=\"1\"/><path d=\"M 12.565 39.435 A 19 19 0 1 1 39.435 39.435\" fill=\"none\" stroke=\"var(--live-track,#777)\" stroke-width=\"2.5\"/><path d=\"M 12.565 39.435 A 19 19 0 1 1 39.435 39.435\" fill=\"none\" stroke=\"var(--live-accent,#03c3d5)\" stroke-width=\"2.5\" pathLength=\"100\" stroke-dasharray=\"100\" stroke-dashoffset=\"40\"/><circle class=\"ds-live-face\" cx=\"26\" cy=\"26\" r=\"13\"/><line x1=\"26\" y1=\"26\" x2=\"26\" y2=\"14\" stroke=\"var(--live-ink,#ededeb)\" stroke-width=\"2\" transform=\"rotate(27 26 26)\"/></svg><input type=\"range\" min=\"0\" max=\"100\" value=\"60\" aria-label=\"Cutoff\"></span><span class=\"ds-live-readout\">60 <span>Hz</span></span></label><label class=\"ds-live-control ds-live-slider-control\"><span>Level</span><span class=\"ds-live-slider\"><input type=\"range\" min=\"0\" max=\"100\" value=\"70\" aria-label=\"Level\"></span><span class=\"ds-live-readout\">0.7</span></label></div>",
      "css": ".ds-live-controls{display:flex;align-items:start;gap:14px;padding:12px;background:var(--live-surface,#363636)}.ds-live-control{font-family:var(--live-font,\"Liberation Sans\",\"Helvetica Neue\",sans-serif);font-size:11px;line-height:1.3;font-variant-numeric:tabular-nums;display:grid;justify-items:center;align-content:start;gap:3px;min-width:76px;color:var(--live-ink,#ededeb)}.ds-live-dial{position:relative;display:inline-block;width:52px;height:52px}.ds-live-dial svg{display:block;width:100%;height:100%}.ds-live-face{fill:var(--live-well,#202020)}.ds-live-dial input{position:absolute;inset:0;width:100%;height:100%;margin:0;opacity:0;cursor:ns-resize}.ds-live-dial:has(input:hover:not(:disabled)) .ds-live-face{fill:#141414}.ds-live-dial:has(input:focus-visible),.ds-live-slider:has(input:focus-visible){outline:2px solid var(--live-focus,#91b9ed);outline-offset:2px;border-radius:2px}.ds-live-readout{display:flex;align-items:center;justify-content:center;gap:3px;min-height:22px;color:var(--live-ink,#ededeb)}.ds-live-readout span{font-size:10px;color:var(--live-muted,#b5b5b5)}.ds-live-slider-control{min-width:150px}.ds-live-slider{display:flex;align-items:center;width:100%;height:24px}.ds-live-slider input{appearance:none;-webkit-appearance:none;width:100%;height:5px;margin:0;padding:0;border:0;border-radius:0;background:linear-gradient(to right,var(--live-accent,#03c3d5) 0 70%,var(--live-well,#202020) 70% 100%);cursor:ew-resize}.ds-live-slider input::-webkit-slider-thumb{appearance:none;-webkit-appearance:none;width:5px;height:15px;border:1px solid var(--live-well,#202020);border-radius:0;background:var(--live-ink,#ededeb)}.ds-live-slider input::-moz-range-thumb{width:5px;height:15px;border:1px solid var(--live-well,#202020);border-radius:0;background:var(--live-ink,#ededeb)}"
    },
