      "name": "Toolbar Button",
      "kind": "button",
      "refersTo": "toolbar-button",
      "description": "Compact editor action.",
      "html": "<button class=\"ds-tool\">Object</button>",
      "css": ".ds-tool{font:12px \"Liberation Sans\", \"Helvetica Neue\", sans-serif;color:var(--text);height:28px;padding:4px 7px;border:1px solid transparent;border-radius:3px;background:transparent;cursor:pointer}.ds-tool:hover{background:#414141}.ds-tool:active{background:#505050}.ds-tool:focus-visible{outline:2px solid var(--selection);outline-offset:2px;}"
    },
    {
      "name": "Object Box",
      "kind": "custom",
      "refersTo": "object-box",
      "description": "One-line class and positional arguments.",
      "html": "<div class=\"ds-object\" tabindex=\"0\"><span>metro</span> 150</div>",
      "css": ".ds-object{font:12px \"Liberation Sans\", \"Helvetica Neue\", sans-serif;color:var(--text);display:inline-flex;align-items:center;gap:5px;height:24px;padding:0 6px;background:var(--object);border-radius:1px;border-top:3px solid #666;border-bottom:3px solid #666}.ds-object span{color:var(--object-name)}.ds-object:focus-visible{outline:2px solid var(--selection);outline-offset:2px;}"
    },
