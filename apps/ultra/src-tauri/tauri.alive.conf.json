{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Alive",
  "version": "0.1.0-rc.1",
  "identifier": "org.alive.session",
  "build": {"frontendDist": "../ui"},
  "app": {
    "enableGTKAppId": true,
    "withGlobalTauri": true,
    "windows": [],
    "security": {"csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'"}
  },
  "bundle": {
    "active": false,
    "resources": {
      "../../alive/examples/two-instruments.alive": "alive-session/alive/examples/two-instruments.alive",
      "../examples/subtractive.ultra": "alive-session/ultra/examples/subtractive.ultra"
    }
  }
}
