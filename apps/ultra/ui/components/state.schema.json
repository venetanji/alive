{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ultra presentation component state v1",
  "description": "Canonical presentation state only, not an Ultra patch or Max runtime document. normalizeState additionally checks finite values, min < max, value clamping and safe integer bounds.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "type": {
      "enum": [
        "object",
        "message",
        "button",
        "toggle",
        "number",
        "flonum",
        "slider",
        "meter",
        "inlet",
        "outlet"
      ]
    },
    "label": {
      "type": "string",
      "maxLength": 256
    },
    "disabled": {
      "type": "boolean"
    },
    "value": {},
    "min": {
      "type": "number"
    },
    "max": {
      "type": "number"
    },
    "step": {
      "type": "number",
      "exclusiveMinimum": 0
    }
  },
  "required": [
    "version",
    "id",
    "type",
    "label",
    "disabled",
    "value"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "object",
              "message"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "value": {
            "type": "string",
            "maxLength": 4096
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "toggle"
          }
        }
      },
      "then": {
        "properties": {
          "value": {
            "enum": [
              0,
              1
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "button",
              "inlet",
              "outlet"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "value": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "number",
              "flonum",
              "slider",
              "meter"
            ]
          }
        }
      },
      "then": {
        "required": [
          "min",
          "max",
          "step"
        ],
        "properties": {
          "value": {
            "type": "number"
          }
        }
      },
      "else": {
        "properties": {
          "min": false,
          "max": false,
          "step": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "number"
          }
        }
      },
      "then": {
        "properties": {
          "value": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "min": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "max": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "step": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        }
      }
    }
  ]
}
